{
  "name": "markhere-monorepo",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "MarkHere local-first Electron Markdown desktop application",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "22.16.x",
    "pnpm": "10.33.x"
  },
  "scripts": {
    "dev": "pnpm --filter @markhere/desktop dev",
    "build": "pnpm --filter @markhere/desktop build",
    "start": "pnpm --filter @markhere/desktop start",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:foundation": "node scripts/verify-foundation.mjs && pnpm check:toolchain && pnpm check:manifests && pnpm check:architecture && pnpm check:provenance",
    "licenses": "node scripts/compliance.mjs licenses",
    "sbom": "node scripts/compliance.mjs sbom",
    "compliance": "node scripts/compliance.mjs all",
    "ci:foundation": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:foundation && pnpm check:secure-shell && pnpm compliance && pnpm build",
    "graph:dependencies": "node scripts/generate-dependency-graph.mjs",
    "check:manifests": "node scripts/check-manifests.mjs",
    "check:secure-shell": "node scripts/verify-secure-shell.mjs",
    "check:secure-shell:runtime": "pnpm --filter @markhere/desktop security:probe"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.9.2",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vue-eslint-parser": "10.4.1",
    "vitest": "4.1.9"
  }
}
