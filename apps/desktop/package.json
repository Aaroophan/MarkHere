{
  "name": "@markhere/desktop",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "MarkHere secure Electron desktop shell",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && vue-tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "security:probe": "node scripts/run-security-probe.mjs"
  },
  "dependencies": {
    "@markhere/document-model": "workspace:*",
    "@markhere/ipc-contract": "workspace:*",
    "@markhere/security-core": "workspace:*",
    "@markhere/shared": "workspace:*",
    "pinia": "3.0.4",
    "vue": "3.5.38",
    "chardet": "2.2.0",
    "chokidar": "5.0.0",
    "iconv-lite": "0.7.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "42.11.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.5",
    "vue-tsc": "3.3.5"
  }
}
